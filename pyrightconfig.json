{
  "typeCheckingMode": "basic",
  "pythonVersion": "3.12",
  "reportMissingImports": true,
  "reportMissingTypeStubs": false,
  "reportOptionalMemberAccess": "warning",
  "reportOptionalSubscript": "warning",
  "reportOptionalCall": "warning",
  "reportUnknownParameterType": "warning",
  "reportUnknownArgumentType": "warning",
  "reportUnknownVariableType": "warning",
  "reportUnknownMemberType": "warning",
  "reportUntypedFunctionDecorator": "warning",
  "reportUnnecessaryIsInstance": "warning",
  "reportUnnecessaryCast": "warning",
  "reportInvalidTypeForm": "error",
  "reportMissingTypeArgument": "warning",
  "reportUnusedImport": "warning",
  "reportUnusedVariable": "warning",
  "reportDeprecated": "warning",
  "include": [
    "jarvis/router.py",
    "jarvis/phrasing.py",
    "jarvis/host-ears/ears.py",
    "jarvis/hermes/executor.py",
    "jarvis/voice_server.py",
    "jarvis/tts_engine.py",
    "jarvis/wyoming_client.py",
    "jarvis/hud.py",
    "jarvis/speaker_model.py",
    "jarvis/policy.py",
    "jarvis/enrol.py",
    "jarvis/diag/actuation_test.py",
    "aether/kernel/policy.py",
    "aether/kernel/router.py"
  ],
  "exclude": [
    "**/__pycache__",
    "**/.git",
    "jarvis/JarvisAi",
    "jarvis/wa",
    "jarvis/ha-config"
  ]
}
