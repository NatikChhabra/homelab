# Copy to .env and fill in. Never commit the real .env.
#
# TAILSCALE_IP is this machine's Tailscale address (find it with
# `tailscale ip -4`, or in the Tailscale admin console). Used to build
# VIKUNJA_SERVICE_PUBLICURL so the web UI's links resolve correctly from other
# devices on your tailnet.
TAILSCALE_IP=
