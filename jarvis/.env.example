# JARVIS Docker Compose Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit the real .env file.

# Home Assistant long-lived access token
# Generate at: HA Settings > People > Your Name > Long-Lived Access Tokens
JARVIS_HASS_TOKEN=

# WhatsApp bridge authentication token
# Rotate if exposed: python -c "import secrets;print(secrets.token_hex(32))"
JARVIS_WA_TOKEN=

# Enable/disable Hermes specialist tier (1=on, 0=off)
JARVIS_HERMES=1

# Home Assistant URL (default inside compose: http://jarvis-hass:8123)
# Change only if running HA outside this stack
JARVIS_HASS_URL=http://jarvis-hass:8123

# Ollama model name (must be pulled first: docker exec jarvis-ollama ollama pull <model>)
OLLAMA_MODEL=qwen2.5:3b

# SearXNG secret key (required, generate with: python -c "import secrets;print(secrets.token_hex(32))")
SEARXNG_SECRET=
