{
  "permissions": {
    "deny": [
      "Bash(docker restart:*)",
      "Bash(docker compose restart:*)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Read(**/secrets.env)",
      "Edit(**/secrets.env)",
      "Write(**/secrets.env)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/session-start.ps1"
          }
        ]
      }
    ]
  }
}
