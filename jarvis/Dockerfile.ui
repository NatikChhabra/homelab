FROM python:3.12-slim

WORKDIR /app

# curl is needed by the compose healthcheck (/healthz).
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl \
 && rm -rf /var/lib/apt/lists/*

# Pinned rather than floating: an aiohttp major bump changes the websocket API
# and would break the audio bridge on an unrelated rebuild.
RUN pip install --no-cache-dir aiohttp==3.10.11 \
 && pip install --no-cache-dir onnxruntime==1.28.0 librosa==0.11.0 numpy==1.26.4 pyyaml

# Every module the server imports must be listed here. On 2026-08-09 the running
# container was found with NO verify/ directory: the image predated it, so the
# server logged "replies will NOT be checked against Home Assistant" and spoke
# unverified confirmations in production while the repo looked complete. A file
# that exists in git but not in the image is worse than a missing feature,
# because the code review passes and the behaviour is still absent.
#
# hud.py is the third instance of exactly that. It was written to disk and
# `docker cp`'d into the running container, so every panel worked -- until the
# host rebooted on 2026-08-09 07:41, the container came back from the image, and
# all six /api/hud/ endpoints returned 404. voice_server.py calls
# hud.register(app) unconditionally, so leaving it out of the image is not a
# missing panel, it is an ImportError that stops the server booting at all.
COPY wyoming_client.py voice_server.py tts_engine.py router.py phrasing.py ha_aliases.py hud.py speaker_model.py policy.py enrol.py ./
COPY verify/ ./verify/
COPY perf/ ./perf/
# Hermes: specialist routing + the executor that dispatches what it selects.
# Omitted from the first build, which is why Hermes stayed a benchmark -- the
# module was not in the image, so voice_server.py could never import it.
COPY hermes/ ./hermes/
COPY calls/ ./calls/
COPY ui/ ./ui/
# speakers/ holds profiles.yaml and identities.yaml at runtime (bind-mounted).
# The COPY provides a fallback when the dir exists in the build context.
COPY speakers/ ./speakers/

# Single port: the app serves both the page and the websocket. The old image
# ran a Flask API and a python -m http.server on different ports, which meant
# the page's fetch('/api/...') calls hit the static server and 404'd.
EXPOSE 3100

CMD ["python", "-u", "voice_server.py"]
